{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@bestfriend/core": ["../../packages/core/src/renderer-public.ts"],
      "@bestfriend/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": [
    "src/renderer/**/*"
  ]
}
